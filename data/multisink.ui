<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkApplicationWindow" id="main_window">
    <property name="title">Multi-output audio</property>
    <property name="default-width">480</property>
    <property name="default-height">260</property>
    <property name="resizable">true</property>

    <child>
      <object class="GtkBox" id="root_box">
        <property name="orientation">vertical</property>
        <property name="spacing">6</property>
        <property name="margin-start">8</property>
        <property name="margin-end">8</property>
        <property name="margin-top">8</property>
        <property name="margin-bottom">8</property>

        <!-- Status label -->
        <child>
          <object class="GtkLabel" id="status_label">
            <property name="xalign">0</property>
            <property name="wrap">true</property>
          </object>
        </child>

        <!-- List of sinks -->
        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkListBox" id="sink_list">
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
              </object>
            </child>
          </object>
        </child>

        <!-- Buttons -->
        <child>
          <object class="GtkBox" id="buttons_box">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>

            <child>
              <object class="GtkButton" id="refresh_button">
                <property name="label">Refresh</property>
              </object>
            </child>

            <child>
              <object class="GtkButton" id="enable_button">
                <property name="label">Enable combined output</property>
              </object>
            </child>

            <child>
              <object class="GtkButton" id="disable_button">
                <property name="label">Disable combined output</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
